{
  "name": "bogota-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/fetch-data.mjs --fixture && vite",
    "build": "node --env-file-if-exists=.env.local scripts/guard-build.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fetch-data": "node scripts/fetch-data.mjs",
    "fetch-data:local": "node scripts/fetch-data.mjs --local-basemap",
    "check-budget": "node scripts/check-budget.mjs",
    "check-etapas": "node scripts/check-etapas.ts",
    "dev:local": "node --env-file-if-exists=.env.local scripts/fetch-data.mjs --local && vite",
    "dev:release": "node scripts/fetch-data.mjs && vite"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
